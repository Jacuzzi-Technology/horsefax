#!/usr/bin/env bash
# Weekly RanchWorldAds rerun (Richard, Oct 23 2026): crawl new and changed ads on this Mac (3 s per request,
# HorsefaxBot; the HTML cache never leaves the Mac), then load ONLY ads.jsonl into production. Run by launchd
# (~/Library/LaunchAgents/com.horsefax.ranchworldads-weekly.plist). A block or any crawl error stops before the load.
# Logs: ~/horsefax-harvest/ranchworldads/weekly-YYYY-MM-DD.log; one line per run in weekly-summary.log.
set -uo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

APP="$(cd "$(dirname "$0")/.." && pwd)"
DATA="$HOME/horsefax-harvest/ranchworldads"
HOST="root@146.190.128.6"
REMOTE="/var/www/horsefax"
LOG="$DATA/weekly-$(date +%F).log"
SUMMARY="$DATA/weekly-summary.log"
LOCK="$DATA/.weekly.lock"

mkdir "$LOCK" 2>/dev/null || { echo "$(date '+%F %T') skipped: a run is already going" >> "$SUMMARY"; exit 0; }
trap 'rmdir "$LOCK"' EXIT

cd "$APP" || exit 1
echo "== $(date '+%F %T') crawl" >> "$LOG"
if ! caffeinate -is php artisan hf:harvest-ranchworldads --no-load --dir="$DATA" >> "$LOG" 2>&1; then
    echo "$(date '+%F %T') CRAWL FAILED or BLOCKED, nothing loaded; see $LOG" >> "$SUMMARY"
    exit 1
fi
crawl=$(grep '^RanchWorldAds:' "$LOG" | tail -1)

echo "== $(date '+%F %T') load to production" >> "$LOG"
if scp -q -o BatchMode=yes "$DATA/ads.jsonl" "$HOST:/tmp/rwa-ads.jsonl" >> "$LOG" 2>&1 \
    && ssh -o BatchMode=yes "$HOST" "install -o horsefax -g horsefax -m 644 /tmp/rwa-ads.jsonl $REMOTE/storage/app/private/ranchworldads/ads.jsonl \
        && rm /tmp/rwa-ads.jsonl && cd $REMOTE && sudo -u horsefax php artisan hf:harvest-ranchworldads --load-only --dir=$REMOTE/storage/app/private/ranchworldads" >> "$LOG" 2>&1; then
    echo "$(date '+%F %T') ok | ${crawl#RanchWorldAds: } | $(grep '^Loaded:' "$LOG" | tail -1)" >> "$SUMMARY"
else
    echo "$(date '+%F %T') crawl ok, LOAD FAILED; see $LOG" >> "$SUMMARY"
    exit 1
fi
